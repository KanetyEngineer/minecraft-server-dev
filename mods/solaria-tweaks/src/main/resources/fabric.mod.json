{
  "schemaVersion": 1,
  "id": "solariatweaks",
  "version": "${version}",
  "name": "Solaria Tweaks",
  "description": "Solaria SMP helpers in one mod: shared waypoints for Xaero's maps, per-player stat leaderboards, shared build plans for Syncmatica schematics, an observer misplacement guard, Potion Dupe Restore and a light suppression switch.",
  "authors": ["kanety"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.kanety.solaria.SolariaTweaks"],
    "client": ["dev.kanety.solaria.client.SolariaTweaksClient"]
  },
  "mixins": [
    "solariatweaks.mixins.json",
    "solariatweaks.potion.mixins.json",
    { "config": "solariatweaks.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "syncmatica": "*",
    "xaeroworldmap": "*",
    "xaerominimap": "*"
  },
  "breaks": {
    "potiondupe": "*",
    "solariatools": "*"
  }
}
