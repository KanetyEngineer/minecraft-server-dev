# コピーして .env にし、node --env-file=.env src/main.js で起動
MC_HOST=127.0.0.1
MC_PORT=25572
MC_USERNAME=BuilderBot
MC_AUTH=offline
MC_VERSION=1.21.11
# チャットで指示できるプレイヤー（カンマ区切り）
BUILD_OWNERS=kanetyyy
# 起動してすぐ建てる場合（空ならチャットの「!build 名前」を待つ）。BUILD_ORIGIN は "x,y,z" か "here"
BUILD_FILE=
BUILD_ORIGIN=
# 素材のそろえ方: stocked = 手持ちとチェストに用意した素材だけで建てる / gather = 足りない物は自分で集める
BUILD_SUPPLY=stocked
