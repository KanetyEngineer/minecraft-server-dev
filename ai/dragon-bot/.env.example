# コピーして .env にし、node --env-file=.env src/index.js で起動
MC_HOST=127.0.0.1
MC_PORT=25570
MC_USERNAME=DragonBot
MC_AUTH=offline
MC_VERSION=1.21.11
# 方針判断に Claude を使う場合（未設定ならルールベースで動く）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# AI の思考ログを Discord のチャンネルへ送る場合（両方あるときだけ送る）
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
