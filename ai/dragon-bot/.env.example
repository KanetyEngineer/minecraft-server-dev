# コピーして .env にし、node --env-file=.env src/index.js で起動
MC_HOST=127.0.0.1
MC_PORT=25570
MC_USERNAME=DragonBot
MC_AUTH=offline
MC_VERSION=1.21.11
# 方針判断に Claude を使う場合（未設定ならルールベースで動く）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# DragonBot（src/index.js）は MBTI 社会実験と同じく Sonnet 5.5・effort low で、困ったときだけ相談する（上の 2 行より優先）
# CLAUDE_MODEL_DRAGON=claude-sonnet-5-5
# CLAUDE_EFFORT_DRAGON=low
# LLM_MODE=assist   # always にすると毎回相談する
# AI の思考ログを Discord のチャンネルへ送る場合（両方あるときだけ送る）
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
